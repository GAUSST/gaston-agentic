#!/usr/bin/env sh
# OS-native shim. All platform selection lives in .agentic/launcher.py.
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if ! command -v python3 >/dev/null 2>&1 || ! python3 -c 'import sys; raise SystemExit(sys.version_info < (3,10))'; then
  printf '%s\n' 'Python 3.10 or newer is required. Install it, then rerun dev init.' >&2
  exit 2
fi
# One-time per-user CLI registration, independent of pip/PEP 668.
# Do not block the engineering runtime on an alias-install failure.
if [ "${GASTON_SKIP_CLI_BOOTSTRAP:-0}" != "1" ]; then
  python3 "$HERE/.agentic/cli_bootstrap.py" || true
fi
exec python3 "$HERE/.agentic/launcher.py" "$@"
